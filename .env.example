# ==============================================================================
# GESTÃO X · OSDEL TECNOLOGIA - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================

# --- FRONTEND (Vite / Vercel) ---
# URL da API Backend hospedada no PythonAnywhere ou servidor próprio
# Em desenvolvimento local: http://localhost:5000
VITE_API_BASE_URL=https://osdelltecnologia.pythonanywhere.com
VITE_APP_NAME="Gestão X"
VITE_COMPANY_NAME="OSDEL TECNOLOGIA"
VITE_DEFAULT_SERVICE_MODE=combo
VITE_SYNC_INTERVAL_MS=30000

# --- BACKEND (Flask / PythonAnywhere) ---
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000
SECRET_KEY=sua-chave-secreta-super-segura-gerada-com-uuid-ou-openssl
JWT_SECRET_KEY=sua-chave-jwt-super-segura-osdel-2026

# --- BANCO DE DADOS (Camada de Abstração) ---
# SQLite por defeito (sem custos, pronto para o PythonAnywhere Free):
DATABASE_URL=sqlite:///osdel_database.db
# Para futura migração para PostgreSQL (Supabase / Neon / RDS / Cloud SQL):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# --- CORS & ORIGENS PERMITIDAS ---
# Lista de origens separadas por vírgula que podem aceder à API
ALLOWED_ORIGINS=https://gestaox.vercel.app,http://localhost:3000,http://localhost:5173,capacitor://localhost,ionic://localhost

# --- SUPER ADMIN PADRÃO ---
SUPERADMIN_USERNAME=deezy
SUPERADMIN_PASSWORD=osdel@master#2026
