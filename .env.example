# ==============================================================================
# GESTÃO X · OSDEL TECNOLOGIA - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# 100% Vercel Serverless (Node.js) + Vite + Supabase (PostgreSQL Grátis)
# ==============================================================================

# --- SUPABASE (PostgreSQL Grátis) ---
# Obtenha estas credenciais no painel do Supabase: Project Settings -> API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-publica-do-supabase
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-do-supabase

# --- FRONTEND (Vite / Vercel) ---
# Na Vercel, deixe vazio ou use a mesma origem para evitar qualquer problema de CORS
VITE_API_BASE_URL=
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica-do-supabase
VITE_APP_NAME="Gestão X"
VITE_COMPANY_NAME="OSDEL TECNOLOGIA"
VITE_DEFAULT_SERVICE_MODE=combo
VITE_SYNC_INTERVAL_MS=30000

# --- SEGURANÇA & JWT ---
PORT=3000
JWT_SECRET=osdel-gestao-x-master-jwt-secret-2026

# --- CORS & ORIGENS PERMITIDAS ---
ALLOWED_ORIGINS=https://gestaox.vercel.app,http://localhost:3000,capacitor://localhost,ionic://localhost

# --- SUPER ADMIN PADRÃO ---
SUPERADMIN_USERNAME=deezy
SUPERADMIN_PASSWORD=osdel@master#2026
